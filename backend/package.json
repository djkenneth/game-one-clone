{
  "name": "backend",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "studio": "prisma studio",
    "migration:create": "prisma migrate dev --create-only",
    "migrate": "prisma migrate dev",
    "migration:prod": "prisma migrate deploy",
    "reset:seed": "prisma migrate reset",
    "reset": "prisma migrate reset --skip-seed",
    "lint": "eslint . --ext .ts",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write '**/*.ts{,x}'",
    "check:types": "tsc --noEmit",
    "check:spell": "git diff --name-only | cspell --no-summary --no-progress --no-must-find-files --file-list stdin",
    "check:all": "concurrently \"pnpm lint\" \"pnpm check:types\" \"pnpm check:spell\"",
    "pre-commit": "concurrently \"lint-staged --allow-empty\" \"pnpm check:types\" \"pnpm check:spell\""
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@elysiajs/bearer": "0.8.0",
    "@elysiajs/cors": "0.8.0",
    "@elysiajs/jwt": "0.8.0",
    "@elysiajs/swagger": "0.7.3",
    "@prisma/client": "^6.3.0",
    "bcrypt": "^5.1.1",
    "elysia": "0.8.0",
    "prisma": "^6.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "bun-types": "latest",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0"
  }
}
