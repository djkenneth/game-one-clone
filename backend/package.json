{
  "name": "backend",
  "version": "1.0.0",
  "module": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "studio": "prisma studio",
    "migration:create": "prisma migrate dev --create-only",
    "migrate": "prisma migrate dev",
    "migration:prod": "prisma migrate deploy",
    "reset:seed": "prisma migrate reset",
    "reset": "prisma migrate reset --skip-seed",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "check:types": "tsc --noEmit",
    "check:spell": "git diff --name-only | cspell --no-summary --no-progress --no-must-find-files --file-list stdin",
    "check:all": "concurrently \"bun run lint\" \"bun run check:types\" \"bun run check:spell\"",
    "pre-commit": "concurrently \"lint-staged --allow-empty\" \"bun run check:types\" \"bun run check:spell\"",
    "seed": "bun prisma/seed.ts"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "prisma": {
    "seed": "bun run seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-validator": "^0.7.6",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.4.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "hono": "^4.11.9",
    "pg": "^8.18.0",
    "prisma": "^7.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "bun-types": "latest",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
